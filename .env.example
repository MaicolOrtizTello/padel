# Copy to .env (root, used by docker compose) and backend/.env (local dev). Never commit .env.

# Database
POSTGRES_USER=americano
POSTGRES_PASSWORD=change_me
POSTGRES_DB=americano

# Local development outside Docker (backend/.env)
DATABASE_URL=postgresql://americano:change_me@localhost:5432/americano

# Backend
PORT=3000
JWT_SECRET=change_to_a_long_random_secret

# Production only (VPS .env)
DOMAIN=americano.example.com
# Image tag to deploy (set by the deploy pipeline; defaults to latest)
# TAG=latest
